# ——— Skopiuj do .env i uzupełnij: cp .env.example .env ———

# Baza danych (kontener db)
POSTGRES_DB=prosail
POSTGRES_USER=prosail
# Wygeneruj: openssl rand -base64 24
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-haslo

# Sekret sesji — MIN. 32 ZNAKI. Wygeneruj: openssl rand -base64 48
JWT_SECRET=zmien-mnie-na-losowy-ciag-minimum-32-znaki
# Jak długo trwa sesja po zalogowaniu
SESSION_TTL=12h
# true, gdy działasz na HTTPS (profil tls) — ciasteczko tylko po HTTPS
COOKIE_SECURE=false

# Pierwszy administrator (używany przez: docker compose exec api npx tsx scripts/seed.ts)
ADMIN_EMAIL=ty@example.com
ADMIN_PASSWORD=zmien-to-haslo-min-8-znakow
ADMIN_NAME=Administrator

# ——— HTTPS (profil "tls") ———
# Domena musi w DNS wskazywać (rekord A/AAAA) na publiczne IP Twojego VPS.
DOMAIN=twojadomena.pl
EMAIL=twoj-email@example.com
